# ---- TrueLense server config ----

# Port the API server runs on
PORT=5000

# Which detection provider to use. Currently supported: "sightengine"
DETECTOR_PROVIDER=sightengine

# Sightengine credentials (https://sightengine.com)
# Free account gives a trial quota of check calls - enough to test this project.
# Create an account, create an app, and copy the API User / API Secret below.
SIGHTENGINE_API_USER=your_api_user_here
SIGHTENGINE_API_SECRET=your_api_secret_here

# How many evenly-spaced frames to pull out of a video for analysis
VIDEO_SAMPLE_FRAMES=8

# Max upload size in MB
MAX_UPLOAD_MB=100

# Authentication Secret (change in production)
JWT_SECRET=your_jwt_secret_key_here

# Configurable Authorized Admin Emails (Comma-separated)
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com
ADMIN_PASSWORD=Admin@TrueLense2026!
ADMIN_NAME=TrueLense Administrator


